widget = {
	allow_outside = yes
	name = "agot_dragon_customizer"
	size = { 600 728 } # Size of the insert inside the event window; needs to fit under the text box since a margin will only push the content and not the widget

	oncreate = "[GetVariableSystem.Set('agot_dc_tab', 'colors')]"
	oncreate = "[GetVariableSystem.Set('agot_dc_channel', 'primary')]"
	oncreate = "[GetScriptedGui('agot_dc_increment_value_set').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
	oncreate = "[GetScriptedGui('agot_dc_select_channel').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope('value', MakeScopeValue('(CFixedPoint)1')).End )]"

	vbox = {
		allow_outside = yes
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding
		position = { 0 4 } # Pushes the box around
		datacontext = "[GetPlayer.MakeScope]" # Needs player scope to reference stored values

		# TABS AND BUTTONS
		hbox = {
			layoutpolicy_horizontal = expanding
			max_width = 580
			spacing = 6

			button_standard = {
				name = "dragon_colors_tab"
				size = { 120 32 }
				onclick = "[GetVariableSystem.Set('agot_dc_tab', 'colors')]"
				down = "[GetVariableSystem.HasValue('agot_dc_tab', 'colors')]"
				text = agot_dc_tab_colors
			}
			button_standard = {
				name = "dragon_body_tab"
				size = { 120 32 }
				onclick = "[GetVariableSystem.Set('agot_dc_tab', 'body')]"
				down = "[GetVariableSystem.HasValue('agot_dc_tab', 'body')]"
				text = agot_dc_tab_body
			}
			button_standard = {
				name = "dragon_head_tab"
				size = { 120 32 }
				onclick = "[GetVariableSystem.Set('agot_dc_tab', 'head')]"
				down = "[GetVariableSystem.HasValue('agot_dc_tab', 'head')]"
				text = agot_dc_tab_head
			}

			expand = {}

			# Randomize appearance
			button_randomize = {
				size = { 32 32 }
				tooltip = agot_dc_randomize_tt
				onclick = "[GetScriptedGui('agot_dragon_customizer_randomize').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
				onclick = "[GetVariableSystem.Clear('agot_dc_palette_primary')]"
				onclick = "[GetVariableSystem.Clear('agot_dc_palette_secondary')]"
				onclick = "[GetVariableSystem.Clear('agot_dc_palette_tertiary')]"
				onclick = "[GetVariableSystem.Clear('agot_dc_palette_eye')]"
				onclick = "[GetVariableSystem.Clear('agot_dc_palette_horn')]"
				enabled = "[GetScriptedGui('agot_dragon_customizer_randomize').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
			}
			# Reset everything to the values from when the customizer was opened
			button_replace = {
				button_ignore = none
				onclick = "[GetScriptedGui('agot_dragon_customizer_reset_all').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
				onclick = "[GetVariableSystem.Clear('agot_dc_palette_primary')]"
				onclick = "[GetVariableSystem.Clear('agot_dc_palette_secondary')]"
				onclick = "[GetVariableSystem.Clear('agot_dc_palette_tertiary')]"
				onclick = "[GetVariableSystem.Clear('agot_dc_palette_eye')]"
				onclick = "[GetVariableSystem.Clear('agot_dc_palette_horn')]"
				enabled = "[GetScriptedGui('agot_dragon_customizer_reset_all').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
				tooltip = agot_dc_reset_all_tt
			}

			# Copy and Paste
			hbox = {
				button_store_values = {
					size = { 32 32 }
					onclick = "[GetScriptedGui('agot_store_dragon_dna').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope('dragon',Scope.GetCharacter.MakeScope).End)]"
					onclick = "[GetVariableSystem.Set('applied_dragon_dna', 'false')]"
					tooltip = DRAGON_DESIGNER_STORE_DNA_TOOLTIP
					using = tooltip_above
				}
				button_apply_values = {
					size = { 32 32 }
					enabled = "[And(GetScriptedGui('agot_has_saved_dragon_dna').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End), GetVariableSystem.HasValue('applied_dragon_dna', 'false'))]"
					onclick = "[GetScriptedGui('agot_apply_dragon_dna').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope('dragon',Scope.GetCharacter.MakeScope).End)]"
					onclick = "[GetVariableSystem.Set('applied_dragon_dna', 'true')]"
					tooltip = DRAGON_DESIGNER_APPLY_DNA_TOOLTIP
					using = tooltip_above
				}
				button_restore_values = {
					size = { 32 32 }
					enabled = "[GetVariableSystem.HasValue('applied_dragon_dna', 'true')]"
					onclick = "[GetScriptedGui('agot_undo_applied_dragon_dna').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope('dragon',Scope.GetCharacter.MakeScope).End)]"
					onclick = "[GetVariableSystem.Set('applied_dragon_dna', 'false')]"
					tooltip = DRAGON_DESIGNER_UNDO_DNA_TOOLTIP
					using = tooltip_above
				}
			}
			expand = {}
		}

		spacer = { size = { 0 4 } }

		# TAB CONTENT
		scrollbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding

			blockoverride "scrollbox_content" {
				margin_top = 2

				# COLORS TAB
				vbox = {
					layoutpolicy_horizontal = expanding
					spacing = 4
					visible = "[GetVariableSystem.HasValue('agot_dc_tab', 'colors')]"

					# Color palette box
					agot_dragon_customizer_color_picker = {}

					# Primary
					agot_dc_slider_row = {
						margin_top = 4
						visible = "[GetVariableSystem.HasValue('agot_dc_channel', 'primary')]"
						blockoverride "label" {
							text = dragon_primary_color_hue_de_gui
						}
						blockoverride "value" {
							text = "[Scope.Var('editing_dragon').ScriptValue('gene_dragon_primary_color_hue_svalue')|0%]"
						}
						blockoverride "track_value" {
							value = "[Scope.Var('editing_dragon').ScriptValue('gene_dragon_primary_color_hue_svalue')]"
						}
						blockoverride "slider_datacontext" {
							datacontext = "[GetScriptedGui('agot_dragon_primary_color_hue_color_set')]"
						}
						blockoverride "reset" {
							onclick = "[GetScriptedGui('agot_dragon_primary_color_hue_color_reset').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
							enabled = "[GetScriptedGui('agot_dragon_primary_color_hue_color_reset').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
						}
						blockoverride "minus" {
							enabled = "[GetScriptedGui('agot_dragon_primary_color_hue_color_minus').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
							onclick = "[GetScriptedGui('agot_dragon_primary_color_hue_color_minus').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
						}
						blockoverride "plus" {
							enabled = "[GetScriptedGui('agot_dragon_primary_color_hue_color_plus').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
							onclick = "[GetScriptedGui('agot_dragon_primary_color_hue_color_plus').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
						}
					}
					agot_dc_slider_row = {
						visible = "[GetVariableSystem.HasValue('agot_dc_channel', 'primary')]"
						blockoverride "label" {
							text = dragon_primary_color_value_de_gui
						}
						blockoverride "value" {
							text = "[Scope.Var('editing_dragon').ScriptValue('gene_dragon_primary_color_value_svalue')|0%]"
						}
						blockoverride "track_value" {
							value = "[Scope.Var('editing_dragon').ScriptValue('gene_dragon_primary_color_value_svalue')]"
						}
						blockoverride "slider_datacontext" {
							datacontext = "[GetScriptedGui('agot_dragon_skin_color_set')]"
						}
						blockoverride "reset" {
							onclick = "[GetScriptedGui('agot_dragon_skin_color_reset').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
							enabled = "[GetScriptedGui('agot_dragon_skin_color_reset').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
						}
						blockoverride "minus" {
							enabled = "[GetScriptedGui('agot_dragon_skin_color_minus').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
							onclick = "[GetScriptedGui('agot_dragon_skin_color_minus').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
						}
						blockoverride "plus" {
							enabled = "[GetScriptedGui('agot_dragon_skin_color_plus').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
							onclick = "[GetScriptedGui('agot_dragon_skin_color_plus').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
						}
					}
					agot_dc_slider_row = {
						visible = "[GetVariableSystem.HasValue('agot_dc_channel', 'primary')]"
						blockoverride "label" {
							text = dragon_primary_color_saturation_de_gui
							tooltip = dragon_primary_color_saturation_de_gui_tt
						}
						blockoverride "value" {
							text = "[Scope.Var('editing_dragon').ScriptValue('gene_dragon_primary_color_saturation_svalue')|0%]"
						}
						blockoverride "track_value" {
							value = "[Scope.Var('editing_dragon').ScriptValue('gene_dragon_primary_color_saturation_svalue')]"
						}
						blockoverride "slider_datacontext" {
							datacontext = "[GetScriptedGui('agot_dragon_primary_color_saturation_set')]"
						}
						blockoverride "reset" {
							onclick = "[GetScriptedGui('agot_dragon_primary_color_saturation_reset').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
							enabled = "[GetScriptedGui('agot_dragon_primary_color_saturation_reset').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
						}
						blockoverride "minus" {
							enabled = "[GetScriptedGui('agot_dragon_primary_color_saturation_minus').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
							onclick = "[GetScriptedGui('agot_dragon_primary_color_saturation_minus').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
						}
						blockoverride "plus" {
							enabled = "[GetScriptedGui('agot_dragon_primary_color_saturation_plus').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
							onclick = "[GetScriptedGui('agot_dragon_primary_color_saturation_plus').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
						}
					}

					# Secondary
					agot_dc_slider_row = {
						margin_top = 4
						visible = "[GetVariableSystem.HasValue('agot_dc_channel', 'secondary')]"
						blockoverride "label" {
							text = dragon_secondary_hue_de_gui
