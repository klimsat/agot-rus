							onclick = "[GetScriptedGui('agot_dragon_secondary_saturation_plus').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
						}
					}

					# Tertiary
					agot_dc_slider_row = {
						margin_top = 4
						visible = "[GetVariableSystem.HasValue('agot_dc_channel', 'tertiary')]"
						blockoverride "label" {
							text = dragon_tertiary_hue_de_gui
						}
						blockoverride "value" {
