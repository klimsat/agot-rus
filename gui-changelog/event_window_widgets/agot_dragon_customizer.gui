						}
						blockoverride "slider_datacontext" {
							datacontext = "[GetScriptedGui('agot_dragon_secondary_value_color_set')]"
						}
						blockoverride "reset" {
							onclick = "[GetScriptedGui('agot_dragon_secondary_value_color_reset').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
							enabled = "[GetScriptedGui('agot_dragon_secondary_value_color_reset').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
						}
						blockoverride "minus" {
							enabled = "[GetScriptedGui('agot_dragon_secondary_value_color_minus').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
							onclick = "[GetScriptedGui('agot_dragon_secondary_value_color_minus').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
						}
						blockoverride "plus" {
							enabled = "[GetScriptedGui('agot_dragon_secondary_value_color_plus').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
							onclick = "[GetScriptedGui('agot_dragon_secondary_value_color_plus').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
						}
					}
					agot_dc_slider_row = {
						visible = "[GetVariableSystem.HasValue('agot_dc_channel', 'secondary')]"
						blockoverride "label" {
							text = dragon_secondary_saturation_de_gui
							tooltip = dragon_secondary_saturation_de_gui_tt
						}
						blockoverride "value" {
							text = "[Scope.Var('editing_dragon').ScriptValue('gene_dragon_secondary_saturation_svalue')|0%]"
						}
						blockoverride "track_value" {
							value = "[Scope.Var('editing_dragon').ScriptValue('gene_dragon_secondary_saturation_svalue')]"
						}
						blockoverride "slider_datacontext" {
							datacontext = "[GetScriptedGui('agot_dragon_secondary_saturation_set')]"
						}
						blockoverride "reset" {
							onclick = "[GetScriptedGui('agot_dragon_secondary_saturation_reset').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
							enabled = "[GetScriptedGui('agot_dragon_secondary_saturation_reset').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
