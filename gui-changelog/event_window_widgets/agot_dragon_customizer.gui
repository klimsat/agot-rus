						}
						blockoverride "minus" {
							enabled = "[GetScriptedGui('agot_dragon_secondary_hue_color_minus').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
							onclick = "[GetScriptedGui('agot_dragon_secondary_hue_color_minus').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
						}
						blockoverride "plus" {
							enabled = "[GetScriptedGui('agot_dragon_secondary_hue_color_plus').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
							onclick = "[GetScriptedGui('agot_dragon_secondary_hue_color_plus').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
						}
					}
					agot_dc_slider_row = {
