							onclick = "[GetScriptedGui('agot_dragon_eye_color_value_plus').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
						}
					}
					agot_dc_slider_row = {
						visible = "[GetVariableSystem.HasValue('agot_dc_channel', 'eye')]"
						blockoverride "label" {
							text = dragon_eye_color_saturation_de_gui
