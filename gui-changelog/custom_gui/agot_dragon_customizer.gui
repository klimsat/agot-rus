							texture = "gfx/interface/icons/agot_dc_palette_bar.dds"
							framesize = { 2 256 }
							frame = "[Add_int32(FixedPointToInt(Add_CFixedPoint(Multiply_CFixedPoint(Scope.Var('editing_dragon').ScriptValue('gene_dragon_primary_color_hue_svalue'), '(CFixedPoint)127'), '(CFixedPoint)0.5')), '(int32)1')]"
							alpha = "[FixedPointToFloat(Add_CFixedPoint(Multiply_CFixedPoint(Scope.Var('editing_dragon').ScriptValue('gene_dragon_primary_color_value_svalue'), '(CFixedPoint)0.95'), '(CFixedPoint)0.05'))]"
							shaderfile = "gfx/FX/agot_customizer_gui.shader"
							effectname = "AgotSaturationBar"
						}
